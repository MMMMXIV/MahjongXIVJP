<Project>

  <!--
    Single source of truth for cross-project MSBuild settings.
    <Version> must match repo.json here and in the MMMMXIV/DalamudPlugins hub repo.json. Releases are built and published by hand.
  -->

  <PropertyGroup Label="Identity">
    <Version>0.5.4.0</Version>
    <Authors>MMMMXIV, kuchris</Authors>
    <Copyright>Copyright (c) 2026 MMMMXIV. Based on MahjongXIV, Copyright (c) 2026 kuchris, and on FFXIV-AutoMahjongSolver, Copyright (c) 2026 Xeldar Alz.</Copyright>
    <PackageProjectUrl>https://github.com/MMMMXIV/MahjongXIVJP</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MMMMXIV/MahjongXIVJP</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Label="Determinism" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
